# Composer 依赖与锁文件（library 包惯例：不提交 lock）
/vendor/
composer.phar
composer.lock
# 仅为兜底：忽略旧版本地联调（composer.local.json + COMPOSER=...）的历史残留，避免被误提交。
# 该流程已废弃并在 AGENTS.md「Local dev wiring」中标注为「不要复活」——COMPOSER 环境变量是整体替换
# 而非合并清单，只写 {"repositories": [...]} 会静默产出空 vendor。
# 现行做法：临时 composer config repositories.common ... ，提交前必须 --unset（见同节）。
composer.local.json
composer.local.lock

# PHPUnit
/.phpunit.cache/
.phpunit.result.cache
/coverage/

# Node（package.json 仅作脚本桥接，无前端产物）
/node_modules/

# IDE / 编辑器
/.idea/
/.vscode/
*.swp

# 环境变量与本地配置
.env
.env.*

# 操作系统
.DS_Store
Thumbs.db
desktop.ini
